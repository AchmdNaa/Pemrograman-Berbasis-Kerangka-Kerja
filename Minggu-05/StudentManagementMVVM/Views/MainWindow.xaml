<Window x:Class="StudentManagementMVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StudentManagementMVVM.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Student Management System — MVVM"
        Height="720" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" FontFamily="Segoe UI">

    <DockPanel>
        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top" Background="#1E1B4B" Padding="20,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#A5B4FC" FontSize="12"
                           Text="Achmad Najwa · 5025231265 · PBKK D"/>
                <StackPanel>
                    <TextBlock Text="Student Management System" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="WPF dengan pola Model-View-ViewModel (MVVM)" Foreground="#A5B4FC" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}"/>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Kartu statistik dashboard ===== -->
            <UniformGrid Grid.Row="0" Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Mahasiswa" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalMahasiswa}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Rata-rata IPK" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RataRataIpk}" Style="{StaticResource StatValue}" Foreground="{StaticResource Primary}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="IPK Tertinggi" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding IpkTertinggi}" Style="{StaticResource StatValue}" Foreground="{StaticResource Success}"/>
                        <TextBlock Text="{Binding MahasiswaTerbaik}" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Predikat Cumlaude (IPK ≥ 3.51)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding JumlahCumlaude}" Style="{StaticResource StatValue}" Foreground="{StaticResource Warning}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Form ===== -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>

                            <TextBlock Text="NIM" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Nim, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>

                            <TextBlock Text="Nama" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Program Studi" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DaftarProdi}" SelectedItem="{Binding ProgramStudi}" Padding="6,4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Angkatan" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Angkatan, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="IPK" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Ipk, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Email (opsional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Pesan validasi, hanya tampil bila HasError = true -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6"
                                    Padding="10,6" Margin="0,12,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Tambah" Command="{Binding AddCommand}" Background="{StaticResource Success}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Update" Command="{Binding UpdateCommand}" Background="{StaticResource Warning}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Hapus" Command="{Binding DeleteCommand}" Background="{StaticResource Danger}" Style="{StaticResource ActionButton}"/>
                                <Button Content="Bersihkan" Command="{Binding ClearCommand}" Background="{StaticResource Muted}" Style="{StaticResource ActionButton}"/>
                            </WrapPanel>

                            <!-- Ringkasan per prodi -->
                            <TextBlock Text="Sebaran per Program Studi" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,6"/>
                            <ItemsControl ItemsSource="{Binding RingkasanProdi}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11">
                                                    <Run Text="{Binding Jumlah, Mode=OneWay}"/><Run Text=" mhs · IPK "/><Run Text="{Binding RataIpkText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Prodi}" FontSize="12" Foreground="#334155"/>
                                            </DockPanel>
                                            <Border Height="6" CornerRadius="3" Background="{StaticResource Primary}"
                                                    HorizontalAlignment="Left" Width="{Binding BarWidth}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===== Tabel mahasiswa ===== -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Daftar Mahasiswa" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Cari NIM, nama, atau program studi" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Reset" Command="{Binding ResetSearchCommand}"
                                    Background="{StaticResource Muted}" Style="{StaticResource ActionButton}" Margin="0"/>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Line}" BorderBrush="{StaticResource Line}"
                                  RowHeight="30" Background="White" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="110"/>
                                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                                <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramStudi}" Width="170"/>
                                <DataGridTextColumn Header="Angkatan" Binding="{Binding Angkatan}" Width="75"/>
                                <DataGridTextColumn Header="IPK" Binding="{Binding Ipk, StringFormat=0.00}" Width="55"/>
                                <DataGridTextColumn Header="Predikat" Binding="{Binding Predikat}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="{Binding HasilPencarian}" Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
