<UserControl x:Class="AksesKita.Desktop.Views.ReportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Button Content="← Kembali ke Daftar" Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,12"/>
            <TextBlock Text="Detail Laporan &amp; Riwayat Penanganan" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>

            <TextBlock Margin="0,12,0,0" Text="Pilih laporan dari menu Daftar &amp; Manajemen Laporan, lalu tekan Lihat Detail." Foreground="#64748B">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReport}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel DataContext="{Binding SelectedReport}" Margin="0,12,0,0">
                <TextBlock Text="{Binding TicketCode}" FontFamily="Consolas" Foreground="#64748B"/>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Category.Name}" Foreground="#64748B" Margin="0,2,0,8"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Address, StringFormat=Lokasi: {0}}" Foreground="#334155"/>
                <TextBlock Foreground="#334155">
                    <Run Text="Koordinat: "/><Run Text="{Binding Latitude, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Longitude, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Severity, StringFormat=Tingkat keparahan: {0}}" Foreground="#334155"/>
                <TextBlock Text="{Binding Status, StringFormat=Status saat ini: {0}}" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>

                <TextBlock Text="Riwayat Status" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,20,0,8"/>
                <DataGrid ItemsSource="{Binding StatusLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd MMM yyyy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Dari" Binding="{Binding OldStatus}" Width="110"/>
                        <DataGridTextColumn Header="Ke" Binding="{Binding NewStatus}" Width="110"/>
                        <DataGridTextColumn Header="Catatan" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="Oleh" Binding="{Binding UpdatedBy}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Ubah status -->
            <StackPanel Margin="0,20,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReport}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Ubah Status" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NewStatus}" Width="220" HorizontalAlignment="Left" Padding="8"/>
                <TextBlock Text="Catatan (wajib bila ditolak)" Margin="0,8,0,4" FontWeight="SemiBold"/>
                <TextBox Text="{Binding StatusNote, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>
                <Button Content="Simpan Status" Command="{Binding ChangeStatusCommand}" HorizontalAlignment="Left" Padding="14,8" Margin="0,12,0,0" Background="#0F172A" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="{Binding Message}" Foreground="#334155" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
