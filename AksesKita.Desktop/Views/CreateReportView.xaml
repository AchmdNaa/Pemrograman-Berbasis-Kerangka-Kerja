<UserControl x:Class="AksesKita.Desktop.Views.CreateReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Buat Laporan Hambatan Aksesibilitas" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            
            <TextBlock Text="Judul Ringkas Hambatan" Margin="0,16,0,4" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Deskripsi Kondisi &amp; Dampak Mobilitas" Margin="0,12,0,4" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Alamat / Patokan Lokasi" Margin="0,12,0,4" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>

            <Button Content="Kirim Laporan Hambatan" Command="{Binding SubmitReportCommand}" Margin="0,24,0,0" Padding="12" Background="#0F172A" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
