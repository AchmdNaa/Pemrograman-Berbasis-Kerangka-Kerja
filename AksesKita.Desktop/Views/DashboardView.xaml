<UserControl x:Class="AksesKita.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Halo, Pengawas Wilayah DKI Jakarta" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Pantau percepatan pemulihan aksesibilitas publik dan audit hambatan mobilitas ramah disabilitas." Foreground="#64748B" Margin="0,4,0,24"/>

            <!-- Metric Cards -->
            <UniformGrid Columns="4">
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL LAPORAN MASUK" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalReports}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DALAM PENANGANAN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding InProgress}" FontSize="28" FontWeight="Bold" Foreground="#0284C7" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SELESAI &amp; DIPULIHKAN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Resolved}" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF2F2" CornerRadius="12" Padding="16" BorderBrush="#FCA5A5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="VERIFIKASI MENDESAK" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/>
                        <TextBlock Text="{Binding UrgentCount}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Aktivitas Terbaru (5 laporan terakhir dari database) -->
            <TextBlock Text="Aktivitas Terbaru" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,28,0,8"/>
            <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RecentReports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TicketCode}" Foreground="#64748B" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" Foreground="#0284C7" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Belum ada laporan. Buat laporan pertama lewat menu Formulir Laporan Baru." Foreground="#64748B">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalReports}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
