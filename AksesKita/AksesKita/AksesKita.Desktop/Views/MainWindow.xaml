<Window x:Class="AksesKita.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AksesKita.Desktop"
        xmlns:views="clr-namespace:AksesKita.Desktop.Views"
        xmlns:vm="clr-namespace:AksesKita.Desktop.ViewModels"
        Title="AksesKita — Ruang Inklusif" Height="900" Width="1440" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBg}"
        Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportListViewModel}">
            <views:ReportListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateReportViewModel}">
            <views:CreateReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportDetailViewModel}">
            <views:ReportDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ===== Login screen (shown before sign-in) ===== -->
        <ContentControl Content="{Binding LoginVM}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- ===== App shell (shown after sign-in) ===== -->
        <Grid x:Name="ShellRoot" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,22,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Teal}">
                            <Path Data="{StaticResource IcoAccessFill}" Fill="White" Width="24" Height="24" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AksesKita" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="Ruang Inklusif" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TealText}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Content="Keluar"
                            local:Ui.Icon="{StaticResource IcoLogout}" Foreground="{DynamicResource Body}"
                            Command="{Binding LogoutCommand}" Margin="0,12,0,0"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="v2.4 • WCAG 2.1 AA Compliant"
                               FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,12,0,0"/>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource TealTint2}" BorderBrush="{DynamicResource TealBorder}" BorderThickness="1"
                            CornerRadius="14" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Bantuan Akses" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="Command Center Surabaya 112" FontSize="12" Foreground="{DynamicResource TealText}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav: the same five pages for every role; actions inside each page depend on the role -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource NavItem}" Content="Dashboard &amp; Analitik" local:Ui.Icon="{StaticResource IcoChart}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Dashboard, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="Peta Interaktif" local:Ui.Icon="{StaticResource IcoMap}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Map"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=Map, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="Daftar &amp; Manajemen Laporan" local:Ui.Icon="{StaticResource IcoClipboard}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ReportList"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=ReportList, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="Formulir Laporan Baru" local:Ui.Icon="{StaticResource IcoPlus}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CreateReport"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=CreateReport, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="Detail Laporan" local:Ui.Icon="{StaticResource IcoDocument}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ReportDetail"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBool}, ConverterParameter=ReportDetail, Mode=OneWay}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Right side -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Global search: press Enter to jump to the report list -->
                        <TextBox Grid.Column="0" Style="{StaticResource FormInput}" MaxWidth="560" HorizontalAlignment="Stretch"
                                 Background="{DynamicResource PageBg}" BorderBrush="Transparent" Margin="0,0,24,0"
                                 local:Ui.Icon="{StaticResource IcoSearch}"
                                 local:Ui.Placeholder="Cari laporan, lokasi fasilitas, atau ID tiket... (Enter)"
                                 AutomationProperties.Name="Cari laporan"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,10,0"
                                    Command="{Binding CycleScaleCommand}" ToolTip="Ubah ukuran teks &amp; tampilan"
                                    AutomationProperties.Name="Ubah ukuran teks">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Aa" FontWeight="ExtraBold" FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Ukuran" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="{Binding ThemeButtonLabel}" Padding="12,7" Margin="0,0,18,0"
                                    Command="{Binding ToggleThemeCommand}" ToolTip="Ganti mode terang / gelap"
                                    AutomationProperties.Name="Ganti mode terang atau gelap">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="local:Ui.Icon" Value="{StaticResource IcoMoon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeButtonLabel}" Value="Mode Terang">
                                                <Setter Property="local:Ui.Icon" Value="{StaticResource IcoSun}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Navy}" Margin="0,0,11,0">
                                        <Path Style="{StaticResource IconSm}" Data="{StaticResource IcoUser}" Stroke="White"
                                              HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Session.UserName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="{Binding Session.RoleLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
