<UserControl x:Class="AksesKita.Desktop.Views.ReportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AksesKita.Desktop"
             Background="{DynamicResource PageBg}">
    <UserControl.Resources>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasReport, Converter={StaticResource InvBoolToVis}}">
            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Hover}" HorizontalAlignment="Center">
                <Path Style="{StaticResource IconLg}" Data="{StaticResource IcoDocument}" Stroke="{DynamicResource Muted}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Belum ada laporan untuk ditampilkan" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,14,0,4" HorizontalAlignment="Center"/>
            <TextBlock Text="Buat laporan baru atau pilih salah satu dari Daftar &amp; Manajemen Laporan." Style="{StaticResource CardSub}" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <!-- Breadcrumb + actions -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Daftar Laporan" local:Ui.Icon="{StaticResource IcoArrowLeft}"
                                Command="{Binding BackCommand}"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="14,0" FontSize="13" Foreground="{DynamicResource BorderStrong}"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13.5" Foreground="{DynamicResource Muted}">
                            <Run Text="Detail Tiket "/><Run Text="{Binding Report.TicketCode, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Salin ID Tiket" local:Ui.Icon="{StaticResource IcoCopy}" Command="{Binding CopyTicketCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Buka di Peta" local:Ui.Icon="{StaticResource IcoMap}" Margin="10,0,0,0" Command="{Binding OpenMapCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Urgency banner -->
                <Border CornerRadius="16" Padding="22,18" Margin="0,0,0,18" BorderThickness="1"
                        Background="{Binding Report.Severity, Converter={StaticResource SeverityToTint}}"
                        BorderBrush="{Binding Report.Severity, Converter={StaticResource SeverityToTint}, ConverterParameter=border}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoWarning}" Margin="0,0,14,0"
                              Stroke="{Binding Report.Severity, Converter={StaticResource SeverityToBrush}}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BannerTitle}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"
                                       Foreground="{Binding Report.Severity, Converter={StaticResource SeverityToBrush}}"/>
                            <TextBlock Text="{Binding BannerSubtitle}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{Binding Report.Severity, Converter={StaticResource SeverityToBrush}}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                Padding="13,6" Margin="16,0,0,0">
                            <TextBlock Text="{Binding SlaText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Header card -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,22">
                    <StackPanel>
                        <StackPanel Margin="30,28,30,24">
                            <WrapPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource Tag}" Background="{DynamicResource InfoTint2}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding Report.TicketCode}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InfoText}"/>
                                </Border>
                                <Border Style="{StaticResource Tag}" Background="{DynamicResource Hover}" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding Report.Category.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Body}"/>
                                </Border>
                                <Border Style="{StaticResource Tag}" Margin="0,0,8,4"
                                        Background="{Binding Report.Severity, Converter={StaticResource SeverityToTint}}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Report.Severity, Converter={StaticResource SeverityToBrush}}">
                                        <Run Text="Urgensi "/><Run Text="{Binding Report.Severity, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Tag}" Margin="0,0,0,4"
                                        Background="{Binding Report.Status, Converter={StaticResource StatusToTint}}">
                                    <TextBlock Text="{Binding Report.Status, Converter={StaticResource EnumLabel}}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Report.Status, Converter={StaticResource StatusToBrush}}"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding Report.Title}" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Path Style="{StaticResource IconSm}" Data="{StaticResource IcoPin}" Stroke="{DynamicResource Danger}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Report.Address}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Body2}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,16,16" Padding="30,16">
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="Tanggal Pelaporan" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Pelapor" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="{Binding ReporterDisplay}" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Instansi Berwenang" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="Dinas PU Bina Marga Kota Surabaya" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Validasi Lokasi" Style="{StaticResource MetaLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Path Style="{StaticResource IconXs}" Data="{StaticResource IcoCheckCircle}" Stroke="{DynamicResource OkText}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Koordinat GPS tercatat" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OkText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="1*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="Bukti Hambatan Lapangan" Style="{StaticResource CardTitle}"/>
                                <Border Height="280" CornerRadius="12" ClipToBounds="True" Margin="0,16,0,0"
                                        Visibility="{Binding Report.ImagePath, Converter={StaticResource FileExistsToVis}}">
                                    <Image Source="{Binding Report.ImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <Grid Height="180" Margin="0,16,0,0"
                                      Visibility="{Binding Report.ImagePath, Converter={StaticResource FileExistsToVis}, ConverterParameter=invert}">
                                    <Rectangle RadiusX="12" RadiusY="12" Fill="{DynamicResource Surface2}" Stroke="{DynamicResource InputBorder}"
                                               StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Hover}" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCamera}" Stroke="{DynamicResource Body2}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Pelapor tidak melampirkan foto" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="Deskripsi &amp; Kajian Dampak Fisik" Style="{StaticResource CardTitle}"/>
                                <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        CornerRadius="12" Padding="18,16" Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Report.Description}" FontSize="14" Foreground="{DynamicResource Body}" TextWrapping="Wrap" LineHeight="23"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Lokasi Geospasial" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Buka di Peta Interaktif" FontSize="12.5"
                                            HorizontalAlignment="Right" Command="{Binding OpenMapCommand}"/>
                                </Grid>
                                <Border Background="{DynamicResource InfoTint2}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1"
                                        CornerRadius="12" Padding="18,16" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="KOORDINAT TERPASANG" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource InfoText}"/>
                                        <TextBlock Text="{Binding CoordinateText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource InfoText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Report.Address}" FontSize="12.5" Foreground="{DynamicResource Body2}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="26,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Report.SupportCount}" FontSize="40" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Warga Mengalami Hambatan Ini" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="Dukungan warga mempercepat eskalasi prioritas pengerjaan dinas terkait." Style="{StaticResource CardSub}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Saya Mengalami Hal Serupa (+1)"
                                        local:Ui.Icon="{StaticResource IcoThumb}" MinHeight="44"
                                        Command="{Binding AddSupportCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,22">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,18">
                                    <Grid>
                                        <TextBlock Text="Riwayat Penanganan" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Transparansi Publik" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InfoText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Garis penghubung antar-peristiwa -->
                                                <Rectangle Width="2" Fill="{DynamicResource Line}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <Ellipse Width="14" Height="14" Fill="{Binding Color}" Stroke="{DynamicResource Surface}" StrokeThickness="3"
                                                         VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,20">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Body2}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                                                    <TextBlock Text="{Binding Actor}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InfoText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Ubah isi laporan (pemilik laporan berstatus Baru, atau admin) -->
                        <Button Style="{StaticResource GhostButton}" Content="Ubah Isi Laporan" local:Ui.Icon="{StaticResource IcoPencil}"
                                Command="{Binding EditCommand}" Margin="0,0,0,22" MinHeight="42"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>

                        <!-- Admin panel -->
                        <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,22"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Aksi Petugas Verifikator" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource Navy}" BorderThickness="0" Padding="9,3" HorizontalAlignment="Right">
                                        <TextBlock Text="Staf Login" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Perbarui progres pengerjaan lapangan untuk memberi notifikasi otomatis kepada pelapor dan dasbor publik."
                                           Style="{StaticResource CardSub}" Margin="0,6,0,16"/>

                                <TextBlock Text="Pilih Status Penanganan Terbaru" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                                          AutomationProperties.Name="Status penanganan">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding StatusRuleHint}" Style="{StaticResource CardSub}" Margin="0,6,0,0"/>

                                <TextBlock Text="Catatan Resmi Tindak Lanjut Dinas (wajib bila Ditolak)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                         local:Ui.Placeholder="Contoh: Tim lapangan dijadwalkan memperbaiki ramp pada 24 Okt."
                                         AutomationProperties.Name="Catatan tindak lanjut"
                                         Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                                <Button Style="{StaticResource PrimaryButton}" Content="Simpan &amp; Kirim Notifikasi Publik" local:Ui.Icon="{StaticResource IcoSend}"
                                        Command="{Binding SaveStatusCommand}" Margin="0,16,0,0" MinHeight="44"/>
                                <Button Style="{StaticResource GhostButton}" Content="Hapus Laporan Ini" local:Ui.Icon="{StaticResource IcoTrash}"
                                        Foreground="{DynamicResource DangerText}" Command="{Binding DeleteReportCommand}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource TealTint2}" BorderBrush="{DynamicResource TealBorder}" BorderThickness="1"
                                CornerRadius="12" Padding="14,10" Margin="0,0,0,22"
                                AutomationProperties.LiveSetting="Polite">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TealText}" TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="{DynamicResource InfoTint2}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1"
                                CornerRadius="16" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Posko Akses Surabaya" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Ink}"/>
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource Body2}" Margin="0,4,0,0">
                                    <Run Text="Hubungi Command Center Surabaya: "/><Run Text="112" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
