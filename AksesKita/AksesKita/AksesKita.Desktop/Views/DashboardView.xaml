<UserControl x:Class="AksesKita.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AksesKita.Desktop"
             Background="{DynamicResource PageBg}">
    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Root" Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <Border Background="{DynamicResource TealTint2}" BorderBrush="{DynamicResource TealBorder}" BorderThickness="1"
                                CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="Dinas PU Bina Marga &amp; Dishub Kota Surabaya • Data Real-time"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TealText}"/>
                        </Border>
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Pantau percepatan pemulihan aksesibilitas publik dan audit hambatan mobilitas ramah disabilitas di Surabaya."
                                   Style="{StaticResource CardSub}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pemilih periode (segmented control) -->
                        <Border Background="{DynamicResource Hover}" CornerRadius="10" Padding="4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="7 Hari" Command="{Binding SetPeriodCommand}" CommandParameter="7"
                                             IsChecked="{Binding PeriodKey, Converter={StaticResource PageToBool}, ConverterParameter=7, Mode=OneWay}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="30 Hari" Command="{Binding SetPeriodCommand}" CommandParameter="30"
                                             IsChecked="{Binding PeriodKey, Converter={StaticResource PageToBool}, ConverterParameter=30, Mode=OneWay}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Triwulan" Command="{Binding SetPeriodCommand}" CommandParameter="90"
                                             IsChecked="{Binding PeriodKey, Converter={StaticResource PageToBool}, ConverterParameter=90, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="Ekspor Rekap (CSV)" local:Ui.Icon="{StaticResource IcoDownload}"
                                Command="{Binding ExportCsvCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric cards -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL LAPORAN MASUK" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalReports, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding TotalDelta}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OkText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4.5,0">
                    <StackPanel>
                        <TextBlock Text="DALAM PENANGANAN" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding InProgress}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="terverifikasi &amp; sedang diperbaiki" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4.5,0">
                    <StackPanel>
                        <TextBlock Text="SELESAI &amp; DIPULIHKAN" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Resolved, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding ResolvedRate}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9,0,0,0" Background="{DynamicResource DangerTint}" BorderBrush="{DynamicResource DangerBorder}">
                    <StackPanel>
                        <TextBlock Text="VERIFIKASI MENDESAK" Style="{StaticResource MetricLabel}" Foreground="{DynamicResource DangerText}"/>
                        <TextBlock Text="{Binding UrgentCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Danger}"/>
                        <TextBlock Text="{Binding UrgentNote}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Trend + categories -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26,24">
                    <StackPanel>
                        <TextBlock Text="Tren Pelaporan &amp; Penyelesaian" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Volume hambatan dilaporkan vs fasilitas diperbaiki (6 bulan terakhir)"
                                   Style="{StaticResource CardSub}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                            <Ellipse Width="11" Height="11" Fill="{DynamicResource Navy}" VerticalAlignment="Center"/>
                            <TextBlock Text="Masuk" FontSize="12.5" FontWeight="Medium" Margin="7,0,18,0" Foreground="{DynamicResource Body2}"/>
                            <Ellipse Width="11" Height="11" Fill="{DynamicResource Teal}" VerticalAlignment="Center"/>
                            <TextBlock Text="Selesai" FontSize="12.5" FontWeight="Medium" Margin="7,0,0,0" Foreground="{DynamicResource Body2}"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding Trend}" Height="200">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding Incoming}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Body2}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <Border Width="22" Height="{Binding IncomingHeight}" MinHeight="3" Background="{DynamicResource Navy}" CornerRadius="4,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Done}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TealText}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <Border Width="22" Height="{Binding ResolvedHeight}" MinHeight="3" Background="{DynamicResource Teal}" CornerRadius="4,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Month}" FontSize="12.5" Foreground="{DynamicResource Muted}"
                                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource Body2}">
                                <Run Text="Efisiensi Penutupan: "/><Run Text="{Binding ClosingEfficiency, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/><Run Text=" pada periode terpilih"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26,24">
                    <StackPanel>
                        <TextBlock Text="Sebaran Kategori Hambatan" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Klasifikasi infrastruktur yang paling banyak dilaporkan warga pada periode terpilih"
                                   Style="{StaticResource CardSub}" Margin="0,4,0,20"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <Grid Margin="0,0,0,7">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Left"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}">
                                                <Run Text="{Binding Percent, Mode=OneWay}"/><Run Text="% ("/><Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" lap.)"/>
                                            </TextBlock>
                                        </Grid>
                                        <Border Height="8" Background="{DynamicResource Hover}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarFill}"/>
                                                    <ColumnDefinition Width="{Binding BarRest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="4" Background="{Binding Color}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Priority queue + activity log -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26,22">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Antrean Prioritas Kritis Siap Verifikasi" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                        Background="{DynamicResource DangerTint}" BorderBrush="{DynamicResource DangerBorder}">
                                    <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource DangerText}">
                                        <Run Text="{Binding UrgentCount, Mode=OneWay}"/><Run Text=" Butuh Aksi Segera"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="Laporan bahaya fatal bagi pengguna kursi roda &amp; tunanetra yang membutuhkan disposisi instan."
                                   Style="{StaticResource CardSub}" Margin="0,12,0,4"/>

                        <ItemsControl ItemsSource="{Binding PriorityQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <WrapPanel>
                                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Run Text="{Binding Code, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Style="{StaticResource Tag}" Background="{DynamicResource DangerTint2}" Padding="7,2">
                                                        <TextBlock Text="Kritis" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RoseText}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="Dilaporkan "/><Run Text="{Binding Time, Mode=OneWay}"/><Run Text=" oleh "/><Run Text="{Binding Reporter, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Location, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Tinjau" Padding="14,6" MinHeight="32"
                                                    FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"
                                                    Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource GhostButton}" Content="Buka Seluruh Antrean" local:Ui.Icon="{StaticResource IcoArrowRight}"
                                Command="{Binding OpenQueueCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26,22">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                            <Grid>
                                <TextBlock Text="Log Aktivitas Terakhir" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource LinkButton}" Content="Lihat Semua" HorizontalAlignment="Right"
                                        Command="{Binding OpenQueueCommand}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Pembaruan status operasional lintas verifikator &amp; dinas terkait."
                                   Style="{StaticResource CardSub}" Margin="0,12,0,16"/>
                        <ItemsControl ItemsSource="{Binding ActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Body2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
