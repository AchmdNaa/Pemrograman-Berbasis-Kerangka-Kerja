<UserControl x:Class="AksesKita.Desktop.Views.ReportListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AksesKita.Desktop"
             Background="{DynamicResource PageBg}">
    <UserControl.Resources>
        <!-- Baris tabel: latar berubah saat disorot -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="24,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Daftar &amp; Manajemen Laporan" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Pusat kendali verifikasi, eskalasi, dan audit perbaikan hambatan mobilitas di Kota Surabaya."
                           Style="{StaticResource CardSub}" FontSize="13.5" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Laporan Baru" local:Ui.Icon="{StaticResource IcoPlus}"
                    Command="{Binding NewReportCommand}" VerticalAlignment="Center" MinHeight="44"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource FormInput}" Margin="0,0,16,0"
                         local:Ui.Icon="{StaticResource IcoSearch}" local:Ui.Placeholder="Cari judul, lokasi, atau ID tiket..."
                         AutomationProperties.Name="Cari judul, lokasi, atau ID tiket"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status" VerticalAlignment="Center" Foreground="{DynamicResource Body2}" FontSize="13" FontWeight="Medium" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="160" Margin="0,0,16,0"
                              AutomationProperties.Name="Filter status"/>

                    <TextBlock Text="Tingkat" VerticalAlignment="Center" Foreground="{DynamicResource Body2}" FontSize="13" FontWeight="Medium" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" Width="130" Margin="0,0,18,0"
                              AutomationProperties.Name="Filter tingkat"/>

                    <CheckBox Content="Hanya laporan saya" IsChecked="{Binding OnlyMine}" VerticalAlignment="Center" FontSize="13" Margin="0,0,18,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="Reset" Command="{Binding ResetFilterCommand}" MinHeight="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16" Padding="24,14">
                    <Grid>
                        <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource Body2}" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="Sebelumnya" local:Ui.Icon="{StaticResource IcoChevronLeft}"
                                    FontWeight="Medium" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                            <TextBlock Text="{Binding PageText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                       VerticalAlignment="Center" Margin="16,0"/>
                            <Button Style="{StaticResource GhostButton}" FontWeight="Medium"
                                    Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Berikutnya" VerticalAlignment="Center"/>
                                    <Path Style="{StaticResource IconXs}" Data="{StaticResource IcoChevronRight}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Kosong -->
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Reports.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Style="{StaticResource IconLg}" Data="{StaticResource IcoClipboard}" Stroke="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tidak ada laporan yang cocok dengan filter." FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ubah kata kunci atau tekan Reset untuk melihat semua laporan." Style="{StaticResource CardSub}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Reports}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,2,12,0">
                                                <TextBlock Text="{Binding TicketCode}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock Text="{Binding Category.Name}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Style="{StaticResource IconXs}" Data="{StaticResource IcoPin}" Stroke="{DynamicResource Muted}" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Address}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"
                                                        ToolTip="Dukungan warga">
                                                <Path Style="{StaticResource IconXs}" Data="{StaticResource IcoThumb}" Stroke="{DynamicResource Body2}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding SupportCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Body2}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Grid.Column="3" Style="{StaticResource Pill}"
                                                    Background="{Binding Status, Converter={StaticResource StatusToTint}}"
                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToTint}, ConverterParameter=border}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource EnumLabel}}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            </Border>

                                            <Border Grid.Column="4" Style="{StaticResource Pill}"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToTint}}"
                                                    BorderBrush="{Binding Severity, Converter={StaticResource SeverityToTint}, ConverterParameter=border}">
                                                <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                            </Border>

                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Style="{StaticResource GhostButton}" Content="Detail"
                                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Hapus" Margin="8,0,0,0" Foreground="{DynamicResource DangerText}"
                                                        local:Ui.Icon="{StaticResource IcoTrash}"
                                                        Command="{Binding DataContext.DeleteReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
