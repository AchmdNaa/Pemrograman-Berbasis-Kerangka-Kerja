<UserControl x:Class="AksesKita.Desktop.Views.CreateReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AksesKita.Desktop"
             Background="{DynamicResource PageBg}">
    <UserControl.Resources>
        <!-- Kartu kategori fasilitas: ikon dalam kotak, nama, keterangan, titik penanda saat dipilih -->
        <Style x:Key="CategoryCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                                CornerRadius="12" Padding="14,13" MinHeight="150">
                            <Grid>
                                <StackPanel>
                                    <Border x:Name="icoBox" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Hover}" HorizontalAlignment="Left">
                                        <Path x:Name="ico" Style="{StaticResource Icon}" Stroke="{DynamicResource Body}" HorizontalAlignment="Center"
                                              Data="{Binding Name, Converter={StaticResource CategoryToIcon}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Ink}" Margin="0,11,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                                <Path x:Name="check" Style="{StaticResource IconSm}" Data="{StaticResource IcoCheckCircle}" Stroke="{DynamicResource Teal}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Teal}"/>
                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource InfoTint2}"/>
                                <Setter TargetName="icoBox" Property="Background" Value="{DynamicResource TealTint}"/>
                                <Setter TargetName="ico" Property="Stroke" Value="{DynamicResource TealText}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kartu tingkat keparahan: warna mengikuti tingkat, lingkaran radio menandai pilihan -->
        <Style x:Key="SeverityCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" CornerRadius="12" Padding="16,14" BorderThickness="1.5"
                                Background="{Binding Level, Converter={StaticResource SeverityToTint}}"
                                BorderBrush="{Binding Level, Converter={StaticResource SeverityToTint}, ConverterParameter=border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <Ellipse Stroke="{Binding Level, Converter={StaticResource SeverityToBrush}}" StrokeThickness="2"
                                             Fill="{DynamicResource Surface}"/>
                                    <Ellipse x:Name="dot" Width="10" Height="10" Visibility="Collapsed"
                                             Fill="{Binding Level, Converter={StaticResource SeverityToBrush}}"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderThickness" Value="2.5"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="{Binding Level, Converter={StaticResource SeverityToBrush}}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="FontSize" Value="17"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Peringatan darurat -->
            <Border Background="{DynamicResource IndigoTint}" BorderBrush="{DynamicResource IndigoBorder}" BorderThickness="1"
                    CornerRadius="16" Padding="22,18" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoWarning}" Stroke="{DynamicResource IndigoText}"
                          VerticalAlignment="Top" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Hambatan Mengancam Keselamatan Jiwa?" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource IndigoText}"/>
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource IndigoText}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19">
                            <Run Text="Jika terdapat lubang galian terbuka, robohan tiang, atau kabel listrik di jalur pedestrian, segera hubungi "/><Run
                                 Text="Command Center Surabaya 112" FontWeight="Bold" TextDecorations="Underline"/><Run Text="."/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="{Binding FormEyebrow}" Style="{StaticResource EyebrowText}" FontWeight="ExtraBold"/>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource PageTitle}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding FormIntro}" Style="{StaticResource CardSub}" FontSize="13.5" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="1. Kategori Fasilitas Terhambat" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Pilih jenis fasilitas publik yang mengalami kendala mobilitas fisik:" Style="{StaticResource CardSub}" Margin="0,4,0,16"/>
                            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                     BorderThickness="0" Background="Transparent" Margin="0,0,-10,-10"
                                     ItemContainerStyle="{StaticResource CategoryCard}"
                                     AutomationProperties.Name="Kategori fasilitas"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="2. Tingkat Hambatan Terhadap Mobilitas" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Kriteria keparahan menentukan kecepatan eskalasi perbaikan dinas teknis:" Style="{StaticResource CardSub}" Margin="0,4,0,16"/>
                            <ListBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}"
                                     BorderThickness="0" Background="Transparent" Margin="0,0,0,-10"
                                     ItemContainerStyle="{StaticResource SeverityCard}"
                                     HorizontalContentAlignment="Stretch"
                                     AutomationProperties.Name="Tingkat hambatan"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{Binding Level, Converter={StaticResource SeverityToBrush}}"/>
                                                <Border Grid.Column="1" Style="{StaticResource Tag}" Margin="10,0,0,0" BorderThickness="1"
                                                        Background="{DynamicResource Surface}"
                                                        BorderBrush="{Binding Level, Converter={StaticResource SeverityToTint}, ConverterParameter=border}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding Level, Converter={StaticResource SeverityToBrush}}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource Body2}" TextWrapping="Wrap"
                                                       Margin="0,6,0,0" LineHeight="19"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="26,22">
                        <StackPanel>
                            <TextBlock Text="3. Rincian Laporan Hambatan" Style="{StaticResource StepTitle}"/>

                            <Grid Margin="0,18,0,0">
                                <TextBlock Text="Judul Ringkas Hambatan *" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding TitleCounter}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBox Style="{StaticResource FormInput}" MaxLength="100"
                                     local:Ui.Placeholder="Contoh: Guiding block terputus galian utilitas di depan RS Siloam"
                                     AutomationProperties.Name="Judul ringkas hambatan"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Margin="0,18,0,0">
                                <TextBlock Text="Deskripsi Kondisi &amp; Dampak Mobilitas *" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding DescriptionCounter}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBox Style="{StaticResource FormInput}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     local:Ui.Placeholder="Jelaskan detail situasi fisik di lokasi, perkiraan lebar jalan yang tersisa, serta dampaknya bagi pengguna kursi roda, tunanetra, lansia, atau orang tua dengan stroller..."
                                     AutomationProperties.Name="Deskripsi kondisi dan dampak mobilitas"
                                     Height="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="4. Titik Lokasi Presisi" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Pilih lokasi cepat di Surabaya atau isi alamat dan koordinat sendiri." Style="{StaticResource CardSub}" Margin="0,4,0,16"/>

                            <TextBlock Text="Lokasi Cepat (Surabaya)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <ComboBox ItemsSource="{Binding Landmarks}" SelectedItem="{Binding SelectedLandmark}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="Lokasi cepat Surabaya"/>
                                <TextBlock Text="Pilih area/koridor jalan protokol..." Margin="13,0,36,0" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{DynamicResource Muted}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLandmark}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Alamat / Patokan Terdekat *" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <TextBox Style="{StaticResource FormInput}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     local:Ui.Placeholder="Contoh: Jl. Pemuda No. 17, tepat di sebelah halte Suroboyo Bus sisi selatan"
                                     AutomationProperties.Name="Alamat atau patokan terdekat"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalContentAlignment="Top"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Latitude" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FormInput}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Latitude"
                                             Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Longitude" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FormInput}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Longitude"
                                             Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconXs}" Data="{StaticResource IcoPin}" Stroke="{DynamicResource Teal}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Gunakan titik desimal, contoh: -7.2575 dan 112.7521" FontSize="12" Foreground="{DynamicResource Body2}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="5. Foto Bukti Lapangan" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Format JPG atau PNG, maksimal 5 MB." Style="{StaticResource CardSub}" Margin="0,4,0,16"/>

                            <!-- Belum ada foto: zona unggah bergaris putus-putus -->
                            <Grid MinHeight="190" Visibility="{Binding ImagePath, Converter={StaticResource FileExistsToVis}, ConverterParameter=invert}">
                                <Rectangle RadiusX="16" RadiusY="16" Fill="{DynamicResource Surface2}" Stroke="{DynamicResource InputBorder}"
                                           StrokeThickness="2" StrokeDashArray="4 3"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24">
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Hover}" HorizontalAlignment="Center">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCamera}" Stroke="{DynamicResource Body2}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Belum ada foto dipilih" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Body2}"
                                               HorizontalAlignment="Center" Margin="0,10,0,12"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Pilih Foto..." Command="{Binding PickPhotoCommand}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sudah ada foto -->
                            <StackPanel Visibility="{Binding ImagePath, Converter={StaticResource FileExistsToVis}}">
                                <Border Height="190" CornerRadius="12" ClipToBounds="True">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Ganti Foto..." local:Ui.Icon="{StaticResource IcoCamera}" Command="{Binding PickPhotoCommand}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Hapus" local:Ui.Icon="{StaticResource IcoTrash}" Foreground="{DynamicResource DangerText}"
                                            Command="{Binding RemovePhotoCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="26,22">
                        <StackPanel>
                            <TextBlock Text="6. Privasi &amp; Validasi Pelapor" Style="{StaticResource StepTitle}"/>
                            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="12" Padding="14" Margin="0,16,0,0">
                                <CheckBox IsChecked="{Binding IsAnonymous}" AutomationProperties.Name="Laporkan secara anonim">
                                    <StackPanel>
                                        <TextBlock Text="Laporkan Secara Anonim" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="Nama dan identitas Anda disamarkan dari portal dan peta publik." FontSize="12" Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Pesan kesalahan validasi -->
                            <Border Background="{DynamicResource DangerTint}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,9" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerText}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="{Binding SubmitLabel}" Command="{Binding SubmitReportCommand}" Margin="0,16,0,0" MinHeight="50" FontSize="14.5" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="local:Ui.Icon" Value="{StaticResource IcoSend}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="local:Ui.Icon" Value="{StaticResource IcoSave}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="Setiap laporan diverifikasi dalam waktu maksimal 1×24 jam kerja sesuai standar layanan publik inklusif."
                                       FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="8,12,8,0" TextAlignment="Center" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
